{
  "openapi": "3.0.3",
  "info": {
    "title": "微信账单管理 API",
    "description": "查看微信支付账单流水记录,支持多维度筛选和查询",
    "version": "1.0.0"
  },
  "paths": {
    "/finances/wechat-bills": {
      "get": {
        "tags": ["Finance/WechatBill"],
        "summary": "获取微信账单列表",
        "description": "获取微信支付账单流水列表,支持按日期、商户号、交易类型等条件筛选\n\n**测试用例:**\n1. 默认分页查询: 按交易时间倒序\n2. 按日期范围筛选: `trade_time_start=2025-11-01T00:00:00&trade_time_end=2025-11-30T23:59:59`\n3. 按商户号筛选: `mch_id=1234567890`\n4. 按交易类型筛选: `trade_type=NATIVE`\n5. 按交易状态筛选: `trade_state=SUCCESS`\n6. 包含支付渠道信息: `with_channel=true`\n7. 升序排列: `order=asc`",
        "operationId": "getWechatBills",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "trade_time_start",
            "in": "query",
            "description": "交易时间起始(ISO 8601)",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "trade_time_end",
            "in": "query",
            "description": "交易时间结束(ISO 8601)",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "mch_id",
            "in": "query",
            "description": "微信商户号",
            "schema": { "type": "string" }
          },
          {
            "name": "transaction_id",
            "in": "query",
            "description": "微信订单号",
            "schema": { "type": "string" }
          },
          {
            "name": "out_trade_no",
            "in": "query",
            "description": "商户订单号",
            "schema": { "type": "string" }
          },
          {
            "name": "trade_type",
            "in": "query",
            "description": "交易类型",
            "schema": {
              "type": "string",
              "enum": ["NATIVE", "JSAPI", "APP", "H5", "MICROPAY"]
            }
          },
          {
            "name": "trade_state",
            "in": "query",
            "description": "交易状态",
            "schema": {
              "type": "string",
              "enum": ["SUCCESS", "REFUND", "NOTPAY", "CLOSED", "REVOKED", "USERPAYING", "PAYERROR"]
            }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "order",
            "in": "query",
            "description": "排序方式 (asc=升序, desc=降序)",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "list": [
                      {
                        "id": 1,
                        "payment_channel_id": 1,
                        "trade_time": "2025-11-14T10:30:00.000Z",
                        "appid": "wx1234567890abcdef",
                        "mch_id": "1234567890",
                        "sub_mch_id": "",
                        "device_info": "",
                        "transaction_id": "4200001234202511141234567890",
                        "out_trade_no": "ORD202511140001",
                        "openid": "oUpF8uMuAJO_M2pxb1Q9zNjWeS6o",
                        "trade_type": "NATIVE",
                        "trade_state": "SUCCESS",
                        "bank_type": "CMB_CREDIT",
                        "total_fee": "10000",
                        "cash_fee": "10000",
                        "settlement_total_fee": "9940",
                        "fee_type": "CNY",
                        "rate": "0.0060",
                        "attach": "",
                        "body": "商品订单",
                        "created_at": "2025-11-14T12:00:00.000Z",
                        "updated_at": "2025-11-14T12:00:00.000Z"
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/finances/wechat-bills/{wechatBill}": {
      "get": {
        "tags": ["Finance/WechatBill"],
        "summary": "查看微信账单详情",
        "description": "获取指定微信账单的详细信息",
        "operationId": "getWechatBill",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "wechatBill",
            "in": "path",
            "required": true,
            "description": "微信账单ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "payment_channel_id": 1,
                    "trade_time": "2025-11-14T10:30:00.000Z",
                    "appid": "wx1234567890abcdef",
                    "mch_id": "1234567890",
                    "transaction_id": "4200001234202511141234567890",
                    "out_trade_no": "ORD202511140001",
                    "openid": "oUpF8uMuAJO_M2pxb1Q9zNjWeS6o",
                    "trade_type": "NATIVE",
                    "trade_state": "SUCCESS",
                    "bank_type": "CMB_CREDIT",
                    "total_fee": "10000",
                    "cash_fee": "10000",
                    "settlement_total_fee": "9940",
                    "fee_type": "CNY",
                    "rate": "0.0060",
                    "body": "商品订单",
                    "created_at": "2025-11-14T12:00:00.000Z",
                    "updated_at": "2025-11-14T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未授权",
        "content": {
          "application/json": {
            "example": {
              "code": 401,
              "msg": "未授权访问",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "msg": "资源不存在",
              "data": null
            }
          }
        }
      }
    }
  }
}
