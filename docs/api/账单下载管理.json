                    "stats": { "pending": 0, "processing": 0, "completed": 120, "no_statement": 3, "failed": 1, "missing": 241 },
                    "monthly_totals": { "06": { "order_amount": "1347.23", "refund_amount": "1347.10", "settlement_amount": "0.13", "fee_amount": "0.00" } },
                    "days": {
