{
  "openapi": "3.0.3",
  "info": {
    "title": "支付渠道管理 API",
    "description": "管理微信和支付宝支付渠道配置,包括证书上传、参数配置等功能",
    "version": "1.0.0"
  },
  "paths": {
    "/payment-bill/payment-channels": {
      "get": {
        "tags": ["PaymentBill/PaymentChannel"],
        "summary": "获取支付渠道列表",
        "description": "获取支付渠道配置列表,支持按渠道类型、模式等条件筛选\n\n**测试用例:**\n1. 默认分页查询所有渠道\n2. 筛选微信支付渠道: `channel=wechat`\n3. 筛选服务商模式: `mode=service`\n4. 关键词搜索: `keywords=测试`\n5. 组合查询: `channel=alipay&mode=normal`",
        "operationId": "getPaymentChannels",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "channel",
            "in": "query",
            "description": "支付渠道类型",
            "schema": {
              "type": "string",
              "enum": ["wechat", "alipay"]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "支付模式",
            "schema": {
              "type": "string",
              "enum": ["normal", "service"]
            }
          },
          {
            "name": "is_enabled",
            "in": "query",
            "description": "是否启用 (1=启用, 0=停用)",
            "schema": {
              "type": "integer",
              "enum": [0, 1]
            }
          },
          {
            "name": "keywords",
            "in": "query",
            "description": "关键词搜索(渠道名称)",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "list": [
                      {
                        "id": 1,
                        "name": "微信支付-主渠道",
                        "channel": "wechat",
                        "channel_text": "微信支付",
                        "mode": "normal",
                        "is_enabled": true,
                        "is_enabled_text": "启用",
                        "remark": null,
                        "wechat_mch_id": "1234567890",
                        "created_at": "2025-11-14T00:00:00.000Z",
                        "updated_at": "2025-11-14T00:00:00.000Z"
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["PaymentBill/PaymentChannel"],
        "summary": "创建支付渠道",
        "description": "创建新的支付渠道配置,支持微信支付和支付宝\n\n**测试用例:**\n1. 创建微信支付渠道(直连模式)\n2. 创建微信支付渠道(服务商模式)\n3. 创建支付宝渠道(证书模式)\n4. 创建支付宝渠道(公钥模式)",
        "operationId": "createPaymentChannel",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "channel"],
                "properties": {
                  "name": { "type": "string", "description": "渠道名称" },
                  "channel": { "type": "string", "enum": ["wechat", "alipay"], "description": "渠道类型" },
                  "mode": { "type": "string", "enum": ["normal", "service"], "default": "normal", "description": "支付模式:normal-直连,service-服务商" },
                  "is_enabled": { "type": "boolean", "default": true, "description": "是否启用" },
                  "remark": { "type": "string", "description": "备注" },
                  "wechat_mch_id": { "type": "string", "description": "微信商户号" },
                  "wechat_mch_secret_key": { "type": "string", "description": "微信v3密钥" },
                  "wechat_app_id": { "type": "string", "description": "微信AppID" },
                  "wechat_mp_app_id": { "type": "string", "description": "微信公众号AppID" },
                  "wechat_mini_app_id": { "type": "string", "description": "微信小程序AppID" },
                  "wechat_sub_mch_id": { "type": "string", "description": "微信子商户号(服务商模式)" },
                  "wechat_mch_public_cert_file": { "type": "string", "format": "binary", "description": "微信商户公钥证书文件" },
                  "wechat_mch_secret_cert_file": { "type": "string", "format": "binary", "description": "微信商户私钥证书文件" },
                  "wechat_public_cert_file": { "type": "string", "format": "binary", "description": "微信平台公钥证书文件" },
                  "alipay_app_id": { "type": "string", "description": "支付宝AppID" },
                  "alipay_app_secret_cert": { "type": "string", "description": "支付宝应用私钥" },
                  "alipay_service_provider_id": { "type": "string", "description": "支付宝服务商ID(服务商模式)" },
                  "alipay_app_cert_file": { "type": "string", "format": "binary", "description": "支付宝应用公钥证书" },
                  "alipay_public_cert_file": { "type": "string", "format": "binary", "description": "支付宝公钥证书" },
                  "alipay_root_cert_file": { "type": "string", "format": "binary", "description": "支付宝根证书" }
                }
              },
              "examples": {
                "微信支付-直连模式": {
                  "summary": "创建微信支付渠道(直连模式)",
                  "value": {
                    "name": "微信支付-主渠道",
                    "channel": "wechat",
                    "mode": "normal",
                    "wechat_mch_id": "1234567890",
                    "wechat_mch_secret_key": "your_v3_key_here",
                    "wechat_app_id": "wx1234567890abcdef"
                  }
                },
                "支付宝-证书模式": {
                  "summary": "创建支付宝渠道(证书模式)",
                  "value": {
                    "name": "支付宝-主渠道",
                    "channel": "alipay",
                    "mode": "normal",
                    "alipay_app_id": "2021001234567890",
                    "alipay_app_secret_cert": "MIIEvQIBADANBgkqhkiG9w0..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "创建成功",
                  "data": {
                    "id": 1,
                    "name": "微信支付-主渠道",
                    "channel": "wechat",
                    "channel_text": "微信支付",
                    "mode": "normal",
                    "is_enabled": true,
                    "is_enabled_text": "启用"
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-bill/payment-channels/{payment_channel}": {
      "get": {
        "tags": ["PaymentBill/PaymentChannel"],
        "summary": "查看支付渠道详情",
        "description": "获取指定支付渠道的详细配置信息",
        "operationId": "getPaymentChannel",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "payment_channel",
            "in": "path",
            "required": true,
            "description": "支付渠道ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "name": "微信支付-主渠道",
                    "channel": "wechat",
                    "channel_text": "微信支付",
                    "mode": "normal",
                    "is_enabled": true,
                    "is_enabled_text": "启用",
                    "remark": null,
                    "wechat_mch_id": "1234567890",
                    "wechat_app_id": "wx1234567890abcdef",
                    "wechat_mch_public_cert_path": "payment/certs/wechat/1/mch_public.pem",
                    "created_at": "2025-11-14T00:00:00.000Z",
                    "updated_at": "2025-11-14T00:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["PaymentBill/PaymentChannel"],
        "summary": "更新支付渠道",
        "description": "更新支付渠道配置信息,支持上传新的证书文件\n\n**测试用例:**\n1. 更新渠道名称\n2. 更换证书文件\n3. 修改备注信息",
        "operationId": "updatePaymentChannel",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "payment_channel",
            "in": "path",
            "required": true,
            "description": "支付渠道ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "渠道名称" },
                  "is_enabled": { "type": "boolean", "description": "是否启用" },
                  "remark": { "type": "string", "description": "备注" },
                  "wechat_mch_secret_key": { "type": "string", "description": "微信v3密钥" },
                  "wechat_mch_public_cert_file": { "type": "string", "format": "binary", "description": "微信商户公钥证书文件" }
                }
              },
              "examples": {
                "更新名称": {
                  "summary": "更新渠道名称",
                  "value": {
                    "name": "微信支付-备用渠道"
                  }
                },
                "启用/停用渠道": {
                  "summary": "启用或停用支付渠道",
                  "value": {
                    "is_enabled": false
                  }
                },
                "修改备注": {
                  "summary": "修改备注信息",
                  "value": {
                    "remark": "仅用于特殊场景"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "更新成功",
                  "data": {
                    "id": 1,
                    "name": "微信支付-备用渠道",
                    "updated_at": "2025-11-14T01:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "tags": ["PaymentBill/PaymentChannel"],
        "summary": "删除支付渠道",
        "description": "删除支付渠道配置及相关证书文件",
        "operationId": "deletePaymentChannel",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "payment_channel",
            "in": "path",
            "required": true,
            "description": "支付渠道ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "删除成功",
                  "data": null
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未授权",
        "content": {
          "application/json": {
            "example": {
              "code": 401,
              "msg": "未授权访问",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "msg": "资源不存在",
              "data": null
            }
          }
        }
      },
      "ValidationError": {
        "description": "数据校验失败",
        "content": {
          "application/json": {
            "example": {
              "code": 422,
              "msg": "数据校验失败",
              "data": {
                "errors": {
                  "name": ["渠道名称不能为空"],
                  "channel": ["渠道类型必须是 wechat 或 alipay"]
                }
              }
            }
          }
        }
      }
    }
  }
}
