{
  "openapi": "3.0.3",
  "info": {
    "title": "支付宝账单管理 API",
    "description": "查看支付宝账单流水记录,支持多维度筛选和查询",
    "version": "1.0.0"
  },
  "paths": {
    "/payment-bill/alipay-bills": {
      "get": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "获取支付宝账单列表",
        "description": "获取支付宝账单流水列表,支持按日期、商户号、交易类型等条件筛选\n\n**测试用例:**\n1. 默认分页查询: 按账单日期和创建时间倒序\n2. 按日期范围筛选: `bill_date_start=2025-11-01&bill_date_end=2025-11-30`\n3. 按商户号筛选: `alipay_merchant_id=2088123456789012`\n4. 按业务类型筛选: `business_type=online_pay`\n5. 包含支付渠道信息: `with_channel=true`\n6. 升序排列: `order=asc`",
        "operationId": "getAlipayBills",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "bill_date_start",
            "in": "query",
            "description": "账单日期起始(YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "bill_date_end",
            "in": "query",
            "description": "账单日期结束(YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "alipay_merchant_id",
            "in": "query",
            "description": "支付宝商户号",
            "schema": { "type": "string" }
          },
          {
            "name": "alipay_trade_no",
            "in": "query",
            "description": "支付宝交易号",
            "schema": { "type": "string" }
          },
          {
            "name": "merchant_order_no",
            "in": "query",
            "description": "商户订单号",
            "schema": { "type": "string" }
          },
          {
            "name": "business_type",
            "in": "query",
            "description": "业务类型",
            "schema": { "type": "string" }
          },
          {
            "name": "income_expenses",
            "in": "query",
            "description": "收支类型",
            "schema": {
              "type": "string",
              "enum": ["收入", "支出"]
            }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "order",
            "in": "query",
            "description": "排序方式 (asc=升序, desc=降序)",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "list": [
                      {
                        "id": 1,
                        "payment_channel_id": 1,
                        "bill_date": "2025-11-14",
                        "alipay_merchant_id": "2088123456789012",
                        "alipay_trade_no": "2025111422001412341234567890",
                        "merchant_order_no": "ORD202511140001",
                        "business_type": "在线支付",
                        "goods_name": "商品订单",
                        "create_time": "2025-11-14T10:30:00.000Z",
                        "complete_time": "2025-11-14T10:30:05.000Z",
                        "alipay_store_id": "",
                        "alipay_store_name": "",
                        "trade_counterparty": "买家姓名",
                        "counterparty_account": "buy***@example.com",
                        "income_expenses": "收入",
                        "amount": "100.00",
                        "balance": "10500.00",
                        "trade_channel": "支付宝",
                        "memo": "",
                        "created_at": "2025-11-14T12:00:00.000Z",
                        "updated_at": "2025-11-14T12:00:00.000Z"
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}": {
      "get": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "查看支付宝账单详情",
        "description": "获取指定支付宝账单的详细信息",
        "operationId": "getAlipayBill",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "payment_channel_id": 1,
                    "bill_date": "2025-11-14",
                    "alipay_merchant_id": "2088123456789012",
                    "alipay_trade_no": "2025111422001412341234567890",
                    "merchant_order_no": "ORD202511140001",
                    "business_type": "在线支付",
                    "goods_name": "商品订单",
                    "create_time": "2025-11-14T10:30:00.000Z",
                    "complete_time": "2025-11-14T10:30:05.000Z",
                    "trade_counterparty": "买家姓名",
                    "counterparty_account": "buy***@example.com",
                    "income_expenses": "收入",
                    "amount": "100.00",
                    "balance": "10500.00",
                    "trade_channel": "支付宝",
                    "memo": "",
                    "created_at": "2025-11-14T12:00:00.000Z",
                    "updated_at": "2025-11-14T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未授权",
        "content": {
          "application/json": {
            "example": {
              "code": 401,
              "msg": "未授权访问",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "msg": "资源不存在",
              "data": null
            }
          }
        }
      }
    }
  }
}
