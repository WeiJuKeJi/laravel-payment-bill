{
  "openapi": "3.0.3",
  "info": {
    "title": "支付宝账单管理 API",
    "description": "查看支付宝账单流水记录,支持多维度筛选和查询",
    "version": "1.0.0"
  },
  "paths": {
    "/payment-bill/alipay-bills": {
      "get": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "获取支付宝账单列表",
        "description": "获取支付宝账单流水列表,支持按日期、商户号、交易类型等条件筛选\n\n**测试用例:**\n1. 默认分页查询: 按账单日期和创建时间倒序\n2. 按日期范围筛选: `bill_date_start=2025-11-01&bill_date_end=2025-11-30`\n3. 按商户号筛选: `alipay_merchant_id=2088123456789012`\n4. 按业务类型筛选: `business_type=online_pay`\n5. 包含支付渠道信息: `with_channel=true`\n6. 升序排列: `order=asc`",
        "operationId": "getAlipayBills",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "bill_date_start",
            "in": "query",
            "description": "账单日期起始(YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "bill_date_end",
            "in": "query",
            "description": "账单日期结束(YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "alipay_merchant_id",
            "in": "query",
            "description": "支付宝商户号",
            "schema": { "type": "string" }
          },
          {
            "name": "alipay_trade_no",
            "in": "query",
            "description": "支付宝交易号",
            "schema": { "type": "string" }
          },
          {
            "name": "merchant_order_no",
            "in": "query",
            "description": "商户订单号",
            "schema": { "type": "string" }
          },
          {
            "name": "business_type",
            "in": "query",
            "description": "业务类型",
            "schema": { "type": "string" }
          },
          {
            "name": "income_expenses",
            "in": "query",
            "description": "收支类型",
            "schema": {
              "type": "string",
              "enum": ["收入", "支出"]
            }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "order",
            "in": "query",
            "description": "排序方式 (asc=升序, desc=降序)",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "list": [
                      {
                        "id": 1,
                        "payment_channel_id": 1,
                        "bill_date": "2025-11-14",
                        "alipay_merchant_id": "2088123456789012",
                        "alipay_trade_no": "2025111422001412341234567890",
                        "merchant_order_no": "ORD202511140001",
                        "business_type": "在线支付",
                        "goods_name": "商品订单",
                        "create_time": "2025-11-14T10:30:00.000Z",
                        "complete_time": "2025-11-14T10:30:05.000Z",
                        "alipay_store_id": "",
                        "alipay_store_name": "",
                        "trade_counterparty": "买家姓名",
                        "counterparty_account": "buy***@example.com",
                        "income_expenses": "收入",
                        "amount": "100.00",
                        "balance": "10500.00",
                        "trade_channel": "支付宝",
                        "memo": "",
                        "created_at": "2025-11-14T12:00:00.000Z",
                        "updated_at": "2025-11-14T12:00:00.000Z"
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}": {
      "get": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "查看支付宝账单详情",
        "description": "获取指定支付宝账单的详细信息",
        "operationId": "getAlipayBill",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "with_channel",
            "in": "query",
            "description": "是否返回支付渠道信息",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "payment_channel_id": 1,
                    "bill_date": "2025-11-14",
                    "alipay_merchant_id": "2088123456789012",
                    "alipay_trade_no": "2025111422001412341234567890",
                    "merchant_order_no": "ORD202511140001",
                    "business_type": "在线支付",
                    "goods_name": "商品订单",
                    "create_time": "2025-11-14T10:30:00.000Z",
                    "complete_time": "2025-11-14T10:30:05.000Z",
                    "trade_counterparty": "买家姓名",
                    "counterparty_account": "buy***@example.com",
                    "income_expenses": "收入",
                    "amount": "100.00",
                    "balance": "10500.00",
                    "trade_channel": "支付宝",
                    "memo": "",
                    "created_at": "2025-11-14T12:00:00.000Z",
                    "updated_at": "2025-11-14T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}/reconciliation/mark-as-matched": {
      "post": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "标记为已匹配",
        "description": "将支付宝账单标记为已匹配状态,表示已与业务订单成功对账\n\n**测试用例:**\n1. 金额完全匹配: business_id=123, amount_diff=0\n2. 金额有差异但可接受: business_id=456, amount_diff=0.01, remark=手续费差异",
        "operationId": "markAlipayBillAsMatched",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "完全匹配": {
                  "summary": "金额完全匹配",
                  "value": {
                    "business_id": 123,
                    "amount_diff": 0,
                    "remark": "订单金额完全一致"
                  }
                },
                "有差异": {
                  "summary": "金额有差异但可接受",
                  "value": {
                    "business_id": 456,
                    "amount_diff": 0.01,
                    "remark": "手续费差异"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "merchant_order_no": "ORD202511140001",
                    "amount": "100.00",
                    "reconciliation": {
                      "status": {
                        "value": "matched",
                        "label": "已匹配",
                        "color": "success",
                        "icon": "check-circle"
                      },
                      "business_type": "App\\Models\\Order",
                      "business_id": 123,
                      "reconciled_at": "2026-01-08T14:30:00.000Z",
                      "amount_diff": "0.00",
                      "remark": "订单金额完全一致",
                      "reconciled_by": "user_1"
                    }
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}/reconciliation/mark-as-mismatched": {
      "post": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "标记为不匹配",
        "description": "将支付宝账单标记为不匹配状态,表示与业务订单对账失败\n\n**测试用例:**\n1. 金额不符: business_id=789, amount_diff=10.00, remark=支付金额与订单金额不符\n2. 订单状态异常: business_id=101, amount_diff=50.00, remark=订单已取消但仍有支付记录",
        "operationId": "markAlipayBillAsMismatched",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "金额不符": {
                  "summary": "金额不匹配",
                  "value": {
                    "business_id": 789,
                    "amount_diff": 10.00,
                    "remark": "支付金额与订单金额不符"
                  }
                },
                "订单状态异常": {
                  "summary": "订单状态异常",
                  "value": {
                    "business_id": 101,
                    "amount_diff": 50.00,
                    "remark": "订单已取消但仍有支付记录"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "merchant_order_no": "ORD202511140001",
                    "amount": "100.00",
                    "reconciliation": {
                      "status": {
                        "value": "mismatched",
                        "label": "不匹配",
                        "color": "danger",
                        "icon": "times-circle"
                      },
                      "business_type": "App\\Models\\Order",
                      "business_id": 789,
                      "reconciled_at": "2026-01-08T14:30:00.000Z",
                      "amount_diff": "10.00",
                      "remark": "支付金额与订单金额不符",
                      "reconciled_by": "user_1"
                    }
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}/reconciliation/mark-as-manual": {
      "post": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "标记为人工处理",
        "description": "将支付宝账单标记为人工处理状态,表示需要人工介入处理\n\n**测试用例:**\n1. 特殊订单: remark=大额订单需人工核实\n2. 异常情况: business_id=202, remark=系统异常导致自动对账失败",
        "operationId": "markAlipayBillAsManual",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "特殊订单": {
                  "summary": "特殊订单需人工核实",
                  "value": {
                    "remark": "大额订单需人工核实"
                  }
                },
                "异常情况": {
                  "summary": "系统异常",
                  "value": {
                    "business_id": 202,
                    "remark": "系统异常导致自动对账失败"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "merchant_order_no": "ORD202511140001",
                    "amount": "100.00",
                    "reconciliation": {
                      "status": {
                        "value": "manual",
                        "label": "人工处理",
                        "color": "warning",
                        "icon": "hand-paper"
                      },
                      "business_type": null,
                      "business_id": null,
                      "reconciled_at": "2026-01-08T14:30:00.000Z",
                      "amount_diff": "0.00",
                      "remark": "大额订单需人工核实",
                      "reconciled_by": "user_1"
                    }
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}/reconciliation/mark-as-ignored": {
      "post": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "标记为已忽略",
        "description": "将支付宝账单标记为已忽略状态,表示该记录不需要对账\n\n**测试用例:**\n1. 测试订单: remark=测试订单,无需对账\n2. 重复记录: remark=重复的支付记录,已忽略",
        "operationId": "markAlipayBillAsIgnored",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "测试订单": {
                  "summary": "测试订单",
                  "value": {
                    "remark": "测试订单,无需对账"
                  }
                },
                "重复记录": {
                  "summary": "重复记录",
                  "value": {
                    "remark": "重复的支付记录,已忽略"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "merchant_order_no": "ORD202511140001",
                    "amount": "100.00",
                    "reconciliation": {
                      "status": {
                        "value": "ignored",
                        "label": "已忽略",
                        "color": "info",
                        "icon": "eye-slash"
                      },
                      "business_type": null,
                      "business_id": null,
                      "reconciled_at": "2026-01-08T14:30:00.000Z",
                      "amount_diff": "0.00",
                      "remark": "测试订单,无需对账",
                      "reconciled_by": "user_1"
                    }
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-bill/alipay-bills/{alipayBill}/reconciliation/mark-as-pending": {
      "post": {
        "tags": ["PaymentBill/AlipayBill"],
        "summary": "重置为待对账",
        "description": "将支付宝账单重置为待对账状态,清除之前的对账记录\n\n**测试用例:**\n1. 重置对账状态: 无需参数",
        "operationId": "markAlipayBillAsPending",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "example": "application/json"
          },
          {
            "name": "alipayBill",
            "in": "path",
            "required": true,
            "description": "支付宝账单ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "id": 1,
                    "merchant_order_no": "ORD202511140001",
                    "amount": "100.00",
                    "reconciliation": {
                      "status": {
                        "value": "pending",
                        "label": "待对账",
                        "color": "default",
                        "icon": "clock"
                      },
                      "business_type": null,
                      "business_id": null,
                      "reconciled_at": null,
                      "amount_diff": "0.00",
                      "remark": null,
                      "reconciled_by": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未授权",
        "content": {
          "application/json": {
            "example": {
              "code": 401,
              "msg": "未授权访问",
              "data": null
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "msg": "资源不存在",
              "data": null
            }
          }
        }
      },
      "ValidationError": {
        "description": "数据校验失败",
        "content": {
          "application/json": {
            "example": {
              "code": 422,
              "msg": "数据校验失败",
              "data": {
                "errors": {
                  "business_id": ["业务订单ID不能为空"],
                  "remark": ["备注不能为空"]
                }
              }
            }
          }
        }
      }
    }
  }
}
