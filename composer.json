{
    "name": "weijukeji/laravel-payment-bill",
    "description": "Laravel 支付账单管理扩展包，支持微信支付、支付宝账单下载与数据同步",
    "keywords": [
        "laravel",
        "payment",
        "bill",
        "wechat",
        "alipay",
        "reconciliation",
        "yansongda",
        "weijukeji"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ruihua",
            "email": "ruihuachen@qq.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "yansongda/pay": "^3.0",
        "tucker-eric/eloquentfilter": "^3.0",
        "weijukeji/laravel-enum-options": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "WeiJuKeJi\\PaymentBill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeiJuKeJi\\PaymentBill\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WeiJuKeJi\\PaymentBill\\PaymentBillServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
